{
  "name": "portdeck",
  "version": "0.4.2",
  "description": "PortDeck Pulse — console game library for Windows",
  "main": "src/main.cjs",
  "author": "PortDeck contributors",
  "license": "MIT",
  "scripts": {
    "start": "npm run build && electron .",
    "dev": "vite",
    "test": "node --test tests/*.test.cjs",
    "build": "vite build",
    "dist:win": "npm run build && electron-builder --win nsis portable --publish never"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "motion": "^12.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.3.0"
  },
  "devDependencies": {
    "electron": "^34.5.8",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.portdeck.launcher",
    "productName": "PortDeck",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/main.cjs",
      "src/preload.cjs",
      "src/backend/**/*",
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
