{
  "name": "portdeck",
  "version": "1.2.0",
  "description": "PortDeck Pulse — console game library for Windows",
  "main": "src/main.cjs",
  "author": "PortDeck contributors",
  "license": "MIT",
  "scripts": {
    "start": "npm run build && electron .",
    "dev": "vite",
    "test": "node --test tests/*.test.cjs",
    "build": "vite build",
    "native:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-input-bridge.ps1",
    "dist:win": "npm run native:win && npm run build && electron-builder --win nsis portable --publish never",
    "build:android": "vite build --config vite.android.config.mjs",
    "android:sync": "npm run build:android && npx cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "motion": "^12.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.3.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/app": "^8.0.0"
  },
  "devDependencies": {
    "electron": "^34.5.8",
    "electron-builder": "^26.0.12",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/android": "^8.0.0"
  },
  "build": {
    "appId": "com.portdeck.launcher",
    "productName": "PortDeck",
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "assets/native",
        "to": "native",
        "filter": [
          "**/*.exe"
        ]
      }
    ],
    "files": [
      "src/main.cjs",
      "src/preload.cjs",
      "src/backend/**/*",
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "icon": "build/icon.png"
  }
}
